# Postgres (Neon)
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# next-auth v5
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_YANDEX_CLIENT_ID=
AUTH_YANDEX_CLIENT_SECRET=
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=
AUTH_TWITTER_CLIENT_ID=
AUTH_TWITTER_CLIENT_SECRET=

# Провайдеры, чьему email доверяем без claim'а email_verified (через запятую).
# По умолчанию пусто: OAuth-вход на email существующего аккаунта сливает их
# только при подтверждённом адресе, иначе уводит на /login?error=link_required.
# GitHub и Yandex подтверждение не присылают — добавляйте их сюда осознанно.
AUTH_TRUSTED_EMAIL_PROVIDERS=


# canfly SSO client mode for subdomains/apps
AUTH_CANFLY_ISSUER=https://canfly.org/oidc
AUTH_CANFLY_WELL_KNOWN=
AUTH_CANFLY_CLIENT_ID=
AUTH_CANFLY_CLIENT_SECRET=
NEXT_PUBLIC_CANFLY_SSO_ENABLED=false
NEXT_PUBLIC_AUTH_YANDEX_ENABLED=false
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
NEXT_PUBLIC_AUTH_GITHUB_ENABLED=false
NEXT_PUBLIC_AUTH_TWITTER_ENABLED=false

# OpenAI (через Vercel AI Gateway)
OPENAI_API_KEY=sk-xxx

# Vercel Blob
BLOB_READ_WRITE_TOKEN=

# Postmark (magic link emails)
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=

# Cron secret (for Vercel Cron Jobs)
CRON_SECRET=

# Стабильный ключ шифрования closure-переменных Server Actions между деплоями.
# Без него Next генерирует новый ключ на каждый билд, и клиент со старого
# деплоя получает «Failed to find Server Action». Одинаковый на всех инстансах,
# генерация: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# MCP (/api/mcp). Доступ только администраторам. Два способа:
# - OAuth 2.1 для ChatGPT, Claude, Cursor, OpenCode;
# - статический Bearer MCP_TOKEN для локальной отладки, CI и MCP Inspector.
# Без MCP_TOKEN и без OAuth роут отвечает 503.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MCP_TOKEN=

# OAuth включается, когда заданы AUTH_SECRET, NEXT_PUBLIC_BASE_URL и этот
# список. Пользователь обязан быть действующим администратором И входить в
# список email. Пусто — OAuth выключен, работает только MCP_TOKEN.
MCP_OAUTH_ALLOWED_EMAILS=

# Дополнительные точные redirect URI через запятую — для нестандартных
# клиентов. ChatGPT, Claude и loopback-адреса уже разрешены встроенными
# правилами.
MCP_OAUTH_EXTRA_REDIRECT_URIS=

# Хосты, с которых разрешено загружать Client ID Metadata Document (CIMD).
# Пусто — встроенный список: chatgpt.com, chat.openai.com, claude.ai,
# claude.com, localhost, 127.0.0.1, [::1].
MCP_OAUTH_CLIENT_METADATA_HOSTS=

# App
NEXT_PUBLIC_BASE_URL=http://localhost:3000
