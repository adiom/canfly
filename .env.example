# Postgres (Neon)
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# next-auth v5
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_YANDEX_CLIENT_ID=
AUTH_YANDEX_CLIENT_SECRET=
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=

# Провайдеры, чьему email доверяем без claim'а email_verified (через запятую).
# По умолчанию пусто: OAuth-вход на email существующего аккаунта сливает их
# только при подтверждённом адресе, иначе уводит на /login?error=link_required.
# GitHub и Yandex подтверждение не присылают — добавляйте их сюда осознанно.
AUTH_TRUSTED_EMAIL_PROVIDERS=


# canfly SSO client mode for subdomains/apps
AUTH_CANFLY_ISSUER=https://canfly.org/oidc
AUTH_CANFLY_WELL_KNOWN=
AUTH_CANFLY_CLIENT_ID=
AUTH_CANFLY_CLIENT_SECRET=
NEXT_PUBLIC_CANFLY_SSO_ENABLED=false
NEXT_PUBLIC_AUTH_YANDEX_ENABLED=false
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
NEXT_PUBLIC_AUTH_GITHUB_ENABLED=false

# OpenAI (через Vercel AI Gateway)
OPENAI_API_KEY=sk-xxx

# Vercel Blob
BLOB_READ_WRITE_TOKEN=

# Postmark (magic link emails)
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=

# Cron secret (for Vercel Cron Jobs)
CRON_SECRET=

# MCP (/api/mcp). Bearer-токен — единственная защита эндпоинта: его тулы пишут
# в БД напрямую, минуя studio-auth. Без переменной роут отвечает 503.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MCP_TOKEN=

# App
NEXT_PUBLIC_BASE_URL=http://localhost:3000
